# Leave both unset to run on the deterministic mock AI provider (no network
# calls, no key required) - this is the default and recommended starting
# point per the walking-skeleton scope doc (claude/08-walking-skeleton-scope.md).
ANTHROPIC_API_KEY=

# Review-required threshold (FR-4.5/4.6). 0-1; a segment with confidence
# below this is flagged for review. See assumption A2 in 01-requirements.md.
CONFIDENCE_THRESHOLD=0.7

# Optional: lets a note be exported to a Google Doc in your own Drive (the
# "Export to Google Docs" button on a note, and the connect control on
# /library). Leave unset to skip this feature entirely - nothing else in the
# app depends on it. See README's "Google Docs export" section for how to
# create these in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
